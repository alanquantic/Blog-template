# Neon Postgres connection string.
# Use the NON-POOLED string for migrations and the POOLED one for runtime.
# Reference: https://neon.com/docs/connect/connection-pooling
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# Long random string used by Payload to sign tokens, cookies, etc.
# Generate with: openssl rand -base64 48
PAYLOAD_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_STRING

# Optional: only set in production deployments.
# Used by Payload to know its public URL (for cookies, CORS, links).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
